# Copy to .env and adjust, or export these in your shell.

# Path to the llama-server binary (from your llama.cpp build).
# Leave blank to use whatever llama-server is on PATH.
LLAMA_SERVER_BIN=C:\Users\User\Desktop\llama.cpp-master\build\bin\Release\llama-server.exe

# Path to a .gguf model file.
MODEL_PATH=C:\path\to\your\model.gguf

# Address/port the wrapper (OpenAI-compatible API) listens on.
HOST=127.0.0.1
PORT=8000

# Internal llama-server port. Keep this bound to loopback only.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8081

# Set this to attach to an ALREADY RUNNING llama-server instead of spawning one.
# Example: http://127.0.0.1:8080
UPSTREAM_URL=

# Extra args forwarded verbatim to llama-server (space-separated).
# Example: --n-gpu-layers 99 --ctx-size 4096
LLAMA_ARGS=

# Seconds to wait for llama-server to become healthy on boot.
STARTUP_TIMEOUT=120
