# ===== 服务 =====
PORT=3001
NODE_ENV=development

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=xinyu

# ===== Redis =====
# 有密码格式: redis://:密码@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# ===== JWT =====
# 必须修改为随机长字符串！可用命令生成: openssl rand -base64 64
JWT_SECRET=your-jwt-secret

# ===== DeepSeek AI =====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== SMTP 邮件（留空则自动进入开发模式：验证码打印到后端日志）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ===== OAuth（暂未申请可留空）=====
APP_URL=http://your-server-ip:3001
FRONTEND_URL=http://your-server-ip:3001
WECHAT_APPID=
WECHAT_SECRET=
QQ_APPID=
QQ_SECRET=

# ===== bcrypt 轮数 =====
BCRYPT_ROUNDS=12
